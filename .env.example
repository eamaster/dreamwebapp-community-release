# ==============================================================================
# DreamWebApp Environment Variables (Community Edition)
# ==============================================================================

# API Base URL
# - Local development: http://localhost:8787 (Wrangler dev default)
# - Self-hosted production: https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8787

# Contact Submission Endpoint Path
VITE_CONTACT_ENDPOINT=/api/v1/contact

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT_WIDGET=true

# Optional Analytics Tracking
# VITE_GA_ID=G-XXXXXXXXXX
# VITE_GTM_ID=GTM-XXXXXXX

# ==============================================================================
# NOWPayments Crypto Checkout
# ==============================================================================
# Payment secrets are SERVER-SIDE ONLY and must NEVER appear as VITE_* variables.
# They live in worker/.dev.vars (local) and are set via `wrangler secret put` (production).
# See worker/.dev.vars.example for the full list of optional payment secrets.
#
# The frontend only needs VITE_API_BASE_URL (above) to reach the Worker API.
